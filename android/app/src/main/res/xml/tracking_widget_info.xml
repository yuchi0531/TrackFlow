<?xml version="1.0" encoding="utf-8"?>
<!-- ホーム画面ウィジェットの定義。
     updatePeriodMillis=0 にして30分最小制約を回避。更新はスナップショット保存時 +
     MethodChannel 経由の updateAppWidget で行う。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="90dp"
    android:maxResizeWidth="760dp"
    android:maxResizeHeight="380dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/tracking_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/tracking_widget_description" />